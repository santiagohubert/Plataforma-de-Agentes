# ==============================================================================
# ALBIO - Plantilla de Variables de Entorno (.env.example)
# NO COPIAR SECRETOS REALES EN ESTE ARCHIVO
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (Fastify / Better Auth / Prisma / Dify)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Base de Datos PostgreSQL
# En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:password@host:5432/albio?schema=public

# Variables de PostgreSQL para Docker Compose Local (No necesarias en Railway)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=albio

# Autenticación Better Auth (SECRETO - Privada)
# Generar una clave segura aleatoria de al menos 32 caracteres (ej: openssl rand -base64 32)
BETTER_AUTH_SECRET=tu-clave-secreta-de-al-menos-32-caracteres

# URL Pública del Backend (donde corre la API de ALBIO)
# Local: http://localhost:4000 | Railway: https://albio-backend-production.up.railway.app
BETTER_AUTH_URL=http://localhost:4000

# URL Pública del Frontend (para orígenes permitidos en CORS y Better Auth)
# Local: http://localhost:3000 | Railway: https://albio-frontend-production.up.railway.app
FRONTEND_URL=http://localhost:3000

# Orquestador IA Dify (SECRETO - Privada, Backend Únicamente)
DIFY_API_KEY_ALBIO=app-tu-api-key-de-dify-aqui
DIFY_API_URL=https://api.dify.ai/v1

# ------------------------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------------------------
# URL Pública del Backend consumida desde el navegador del usuario (PÚBLICA)
# Nota: Esta variable se inyecta en el cliente web durante el build de Next.js
# Local: http://localhost:4000 | Railway: https://albio-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000
